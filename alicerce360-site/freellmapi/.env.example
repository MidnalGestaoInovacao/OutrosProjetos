# Copie para .env e preencha. NUNCA versione o .env.
# Gere a chave de criptografia com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   (ou: openssl rand -hex 32)
ENCRYPTION_KEY=troque-por-64-caracteres-hexadecimais

PORT=3001

# Limite do próprio FreeLLMAPI (por IP visto pelo serviço). O limite por visitante
# é feito no Nginx; aqui fica uma segunda barreira global.
PROXY_RATE_LIMIT_RPM=120

# Corpo máximo das requisições /v1 (MB). O Nginx já limita a 32 KB.
REQUEST_BODY_LIMIT_MB=1
